# Spawn Agent Command Environment Variables
#
# This is a TEMPLATE, not live config — the framework repo ignores .env, so shipping it
# under that name would silently drop it from a clone. The command never sources this file:
# it reads the same names out of the environment with these defaults baked in. Copy to
# .env (or set them in ~/.<entity>/.env) to override.

# These can be overridden in ~/.alice/.env or passed via command line

# Terminal emulator to use (gnome-terminal, konsole, xterm, etc.)
SPAWN_TERMINAL=gnome-terminal

# Arguments passed to terminal before the command
SPAWN_TERMINAL_ARGS=--

# Claude model to use for subagents
CLAUDE_MODEL=sonnet

# Additional directories to allow tool access (space-separated)
# CLAUDE_ALLOWED_DIRS=$HOME

# Working directory for spawned subagents
SPAWN_WORKDIR=$CWD

# Prefix for session names
SPAWN_SESSION_PREFIX=subagent

# Audit Trailing - save all output to .koad-io in working directory
SPAWN_AUDIT=true                    # Enable audit trailing
SPAWN_AUDIT_DIR=.koad-io            # Folder name for audit logs (relative to workdir)
SPAWN_AUDIT_COMBINE=true            # Combine all output into single audit file
