#!/bin/bash

## koad-io cli wrapper
## a component of koad:io
## copyright kingofalldata.com

## The objective of keeping the script human-readable and linear is quite important. It's crucial
## for non-coders to be able to understand what's happening without getting lost in complex structures
## or abstractions.
## 
## Given this approach, this script is designed in a way that logically unfolds the process step by
## step, and each code block corresponds to a specific action or decision. This can make it easier 
## for non-coders to follow along and comprehend.
## 
## While this script might appear a bit verbose due to the repetition, this design choice aligns well
## with our goal of making it clear and readable. This structure is intended to help users understand
## the process and the decision-making logic. Hopefully our approach seems to be a reasonable trade-off
## between readability and conciseness.

# --- Pre-cascade env sanitization ----------------------------------------
#
# Wipe inherited entity-context and koad-io state vars BEFORE the .env
# cascade waterfall runs. Each koad-io invocation must start with a clean
# slate so the cascade is the single source of truth — preventing leakage
# from parent processes (e.g. dispatching Vulcan from inside a Juno
# session that already has KOAD_IO_ROOTED=true and ENTITY_DIR=/home/koad/.juno
# in env, which would otherwise pollute Vulcan's invocation).
#
# Preserved (caller intent, not entity context):
#   ENTITY            — set by the entity launcher (~/.koad-io/bin/<name>)
#                       immediately before exec; the canonical fresh caller intent
#   KOAD_IO_ROOM      — caller-pinned room for room-mode dispatch
#   KOAD_IO_QUIET     — verbosity preference (also set by --quiet flag)
#
# Wiped:
#   ENTITY_*          — entity context (DIR, HOME, HOST, KEYS, DEFAULT_*).
#                       Re-established from the entity .env in the cascade.
#   KOAD_IO_*         — kingdom flags and entity-context flags
#                       (ROOTED, DEFAULT_*, etc). Re-established from
#                       ~/.koad-io/.env and the entity .env in the cascade.
#
# Spec proposal: VESTA-SPEC-NNN — Pre-Cascade Env Sanitization (forthcoming).

_koad_io_room_pin="$KOAD_IO_ROOM"
_koad_io_quiet_pin="$KOAD_IO_QUIET"

# Detect whether we were called from an entity launcher or directly as koad-io.
# Entity launchers set KOAD_IO_VIA_LAUNCHER=1 before calling us.
# If called directly (no launcher), ENTITY is stale env from a parent shell —
# wipe it and all entity context so framework commands run entity-free.
if [[ "$KOAD_IO_VIA_LAUNCHER" != "1" ]]; then
  unset ENTITY
  # Wipe ALL entity and kingdom env vars — clean slate for framework-only cascade
  while IFS= read -r _v; do
    unset "$_v"
  done < <(compgen -v | grep -E '^(KOAD_IO_|ENTITY)' || true)
  # Re-source kingdom-level env only (no entity).
  # ~/.koad-io/.env if it's a directory, or ~/.koad-io itself if it's a file.
  set -a
  if [ -d "$HOME/.koad-io" ]; then
    [ -f "$HOME/.koad-io/.env" ] && source "$HOME/.koad-io/.env"
    [ -f "$HOME/.koad-io/.credentials" ] && source "$HOME/.koad-io/.credentials"
  elif [ -f "$HOME/.koad-io" ]; then
    source "$HOME/.koad-io"
    [ -f "$HOME/.credentials" ] && source "$HOME/.credentials"
  fi
  set +a
else
  unset KOAD_IO_VIA_LAUNCHER
  # Entity launcher path — wipe everything except ENTITY, re-established by cascade.
  # EXCEPTION: KOAD_IO_MODEL_CEILING is a per-dispatch runtime var exported by
  # `dispatch open` (never present in any .env). Wiping it here is the reason
  # model_ceiling never reached the harness — every dispatch ran the flat .env
  # default regardless of ceiling (tickler 2026-08-01 dispatch-model-routing).
  # Preserve it so the harness can resolve the model via route.js.
  while IFS= read -r _v; do
    case "$_v" in
      ENTITY) ;;                    # set by launcher — preserve
      KOAD_IO_MODEL_CEILING) ;;     # per-dispatch runtime var — preserve
      *)      unset "$_v" ;;
    esac
  done < <(compgen -v | grep -E '^(KOAD_IO_|ENTITY)' || true)
fi

[ -n "$_koad_io_room_pin" ]  && export KOAD_IO_ROOM="$_koad_io_room_pin"
[ -n "$_koad_io_quiet_pin" ] && export KOAD_IO_QUIET="$_koad_io_quiet_pin"
unset _koad_io_room_pin _koad_io_quiet_pin _v

# we want to save CWD as the directory which the command was fired from, and pass this into the regular command.
export CWD=$PWD
[[ $DEBUG ]] && echo "PWD=$PWD" >&2;
[[ $DEBUG ]] && { printf 'ORIG_ARGS (%d):' "$#" >&2; for _a in "$@"; do printf ' %q' "$_a" >&2; done; echo >&2; unset _a; }

# Detect --quiet / -q flag or KOAD_IO_QUIET env var.
# Quiet mode suppresses spinners and ANSI decoration while keeping plain-text status output.
# This is intended for AI sessions, scripts, and CI pipelines where animation causes noise.
for _arg in "$@"; do
  if [[ "$_arg" == "--quiet" || "$_arg" == "-q" ]]; then
    export KOAD_IO_QUIET=1
    break
  fi
done
unset _arg

# Strip --quiet / -q from the argument list so subcommands do not see it.
if [[ "$KOAD_IO_QUIET" == "1" ]]; then
  _filtered_args=()
  for _arg in "$@"; do
    [[ "$_arg" == "--quiet" || "$_arg" == "-q" ]] && continue
    _filtered_args+=("$_arg")
  done
  set -- "${_filtered_args[@]}"
  unset _filtered_args _arg
fi

# ── The argv boundary (VESTA-SPEC-245) ──────────────────────────────────────
#
# The launcher has exactly one job it cannot delegate: find the command.
# Everything else belongs to the command, in the order the caller wrote it.
#
#   The launcher may remove the command words it resolved. It may not add,
#   drop, or move any other token.
#
# _ORIG_ARGV is the caller's argv, untouched, captured before anything else
# touches it. Two derived views are computed by helpers/argv.sh (shared with
# the regression tests, so the behaviour cannot silently drift from what is
# pinned):
#
#   RESOLUTION VIEW — koad_io_split_argv puts the tokens eligible to be
#   command-directory words into _koad_io_positional_args (and their original
#   argv indices into _koad_io_positional_index). Only those are handed to the
#   resolver below. This is the ONLY reason arity knowledge exists: a
#   value-taking flag must not let its value be mistaken for a command word.
#
#   EXEC SLICE — koad_io_exec_slice replays _ORIG_ARGV, skipping exactly the
#   positional tokens resolution consumed. Same tokens, same order, same
#   multiplicity. It removes; it never reorders.
#
# WHAT THIS REPLACED (2026-11-07, and why it mattered)
# ---------------------------------------------------
# The launcher used to do a stable PARTITION: flags moved behind every
# positional and the exec line appended them. No token was lost and the exit
# code was zero, which is how it survived review for months — but it RELOCATES
# a value rather than mangling it, and a relocation inside an order-sensitive
# command inverts meaning silently. `profile view --chain a.json b.json`
# arrived as `b.json --chain a.json`; the boolean `--chain` arm shifted one
# token and `a.json` was read as a chain file. Every token intact, exit 0,
# and a tip-first chain walked genesis-first.
#
# `--` is honoured: classification stops at it, and it is preserved in place.
#
# KOAD_IO_FLAGS is NOT exported (VESTA-SPEC-245 A-5). It was a word-split
# string, so a consumer re-applied the partition after splitting on whitespace
# and lost the caller's quoting a second time. A command reads its own "$@" —
# which now carries every token in the caller's order.
_ORIG_ARGV=("$@")
_argv_helper="$HOME/.koad-io/helpers/argv.sh"
if [[ ! -f "$_argv_helper" ]]; then
  echo "koad-io: missing argv helper: $_argv_helper" >&2
  exit 70
fi
# shellcheck source=../helpers/argv.sh
source "$_argv_helper"
unset _argv_helper
koad_io_split_argv "${_ORIG_ARGV[@]}"
set -- ${_koad_io_positional_args[@]+"${_koad_io_positional_args[@]}"}

[[ $9 ]] && echo 'You have reached the limits here, sorry -- too many arguments.' >&2 && exit 68

# --- Entity git identity ------------------------------------------------------
#
# WHY THIS EXISTS (2026-10-21, from Alice's report)
# ------------------------------------------------
# A dispatched entity starts life with the DISPATCHER's shell environment. The
# cascade above only overwrites the keys an entity's own .env happens to define,
# so anything it omits is silently inherited from whoever dispatched it. Alice's
# .env defined GIT_COMMITTER_NAME/EMAIL and not GIT_AUTHOR_NAME/EMAIL; her first
# commit would have been AUTHORED as "Juno" while being committed as "Alice" —
# and it looks perfectly normal on GitHub unless you read the author field. That
# is exactly what SPEC-117 §4.5 (entity public face) exists to prevent.
#
# Rule: inside an entity invocation authorship is the entity's, in BOTH fields.
# If the entity's own .env/.credentials names it, that wins — it was sourced
# above and is not touched here. If they are silent, the identity is DERIVED
# from the handle, never inherited. This runs in the launcher, so every harness
# (pi, claude, opencode, codex, bash) and every command inherits the right
# identity without each of them re-implementing it.

_koad_io_entity_git_identity() {
  [[ -n "${ENTITY:-}" ]] || return 0

  local _ent_lower="$(printf '%s' "$ENTITY" | tr '[:upper:]' '[:lower:]')"
  local _ent_dir="$HOME/.$_ent_lower"
  local _have_a_name=0 _have_a_mail=0 _have_c_name=0 _have_c_mail=0
  local _f

  for _f in "$_ent_dir/.env" "$_ent_dir/.credentials"; do
    [[ -f "$_f" ]] || continue
    grep -qE '^[[:space:]]*(export[[:space:]]+)?GIT_AUTHOR_NAME='    "$_f" 2>/dev/null && _have_a_name=1
    grep -qE '^[[:space:]]*(export[[:space:]]+)?GIT_AUTHOR_EMAIL='   "$_f" 2>/dev/null && _have_a_mail=1
    grep -qE '^[[:space:]]*(export[[:space:]]+)?GIT_COMMITTER_NAME='  "$_f" 2>/dev/null && _have_c_name=1
    grep -qE '^[[:space:]]*(export[[:space:]]+)?GIT_COMMITTER_EMAIL=' "$_f" 2>/dev/null && _have_c_mail=1
  done

  local _domain="${ENTITY_DOMAIN:-${KOAD_IO_KINGDOM_DOMAIN:-koad.io}}"
  local _display="$(printf '%s' "${_ent_lower:0:1}" | tr '[:lower:]' '[:upper:]')${_ent_lower:1}"

  # Fallbacks come from what the entity DID declare, before anything derived:
  # if it names a committer, that is how it names itself, and the author should
  # match rather than invent a different spelling or domain.
  local _fb_name="" _fb_mail=""
  [[ "$_have_c_name" -eq 1 ]] && _fb_name="${GIT_COMMITTER_NAME:-}"
  [[ "$_have_c_mail" -eq 1 ]] && _fb_mail="${GIT_COMMITTER_EMAIL:-}"

  [[ "$_have_a_name" -eq 0 ]] && export GIT_AUTHOR_NAME="${_fb_name:-$_display}"
  [[ "$_have_a_mail" -eq 0 ]] && export GIT_AUTHOR_EMAIL="${_fb_mail:-$_ent_lower@$_domain}"

  # Whatever the author resolved to IS the entity, so both fields agree.
  [[ "$_have_c_name" -eq 0 ]] && export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
  [[ "$_have_c_mail" -eq 0 ]] && export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
  return 0
}

# Cascade environments BEFORE hook dispatch — hooks need entity env vars
# (CLAUDE_CONFIG_DIR, GIT_AUTHOR_*, ENTITY_DIR, etc.)
set -a
[ -f "$HOME/.koad-io/.env" ] && source "$HOME/.koad-io/.env"
[ -f "$HOME/.koad-io/.credentials" ] && source "$HOME/.koad-io/.credentials"
if [[ -n "$ENTITY" ]]; then
  ENTITY_LOWER="$(echo "$ENTITY" | tr '[:upper:]' '[:lower:]')"
  [ -f "$HOME/.$ENTITY_LOWER/.env" ] && source "$HOME/.$ENTITY_LOWER/.env"
  [ -f "$HOME/.$ENTITY_LOWER/.credentials" ] && source "$HOME/.$ENTITY_LOWER/.credentials"
fi
set +a
_koad_io_entity_git_identity

# ensure we have arguments to parse, else run the executed-without-arguments hook.
# waterfall: entity hook > CWD hook > global hook
if [[ $# -eq 0 ]]; then
  HOOK_NAME="executed-without-arguments.sh"
  if   [[ -n "$ENTITY" ]] && [[ -f "$HOME/.$ENTITY/hooks/$HOOK_NAME" ]];  then exec "$HOME/.$ENTITY/hooks/$HOOK_NAME";
  elif [[ -f "$PWD/hooks/$HOOK_NAME" ]];                                   then exec "$PWD/hooks/$HOOK_NAME";
  elif [[ -f "$HOME/.koad-io/hooks/$HOOK_NAME" ]];                         then exec "$HOME/.koad-io/hooks/$HOOK_NAME";
  else echo "no hook found for: $HOOK_NAME" >&2 && exit 64;
  fi
fi

# ack — always emit plain-text status so callers can follow progress;
# ANSI decoration is suppressed in quiet mode.
if [[ "$KOAD_IO_QUIET" == "1" ]]; then
  echo "[koad-io] start: $1 (quiet mode)" >&2
else
  echo "--koad-io [$ENTITY] $1 start--" >&2
  echo "$0 [$# arguments]" >&2
  echo "-" >&2
fi
echo "cascading enviroments" >&2
set -a

# Load any global environment details that exist in the koad-io folder.
[ -f $HOME/.koad-io/.env ] && echo "absorbing $HOME/.koad-io/.env" >&2 && set -a && source $HOME/.koad-io/.env 
[ -f $HOME/.koad-io/.credentials ] && echo "absorbing $HOME/.koad-io/.credentials" >&2 && set -a && source $HOME/.koad-io/.credentials 
[ -f $HOME/.koad-io/.aliases ] && echo "absorbing $HOME/.koad-io/.aliases" >&2 && set -a && source $HOME/.koad-io/.aliases 

# ENTITY_DIR is always $HOME/.$ENTITY, lowercased.
# Guard against empty ENTITY — otherwise resolves to "$HOME/."
# which sources $HOME/.env on every no-entity invocation (latent bug 2026-04-21).
[[ -n "$ENTITY" ]] && ENTITY_DIR="$HOME/.$(echo "$ENTITY" | tr '[:upper:]' '[:lower:]')"

# Check and load any environment details from the entity's folder.
if [ -d "$ENTITY_DIR" ]; then
    [ -f $ENTITY_DIR/.env ] && echo "absorbing $ENTITY_DIR/.env" >&2 && set -a && source $ENTITY_DIR/.env
    [ -f $ENTITY_DIR/.credentials ] && echo "absorbing $ENTITY_DIR/.credentials" >&2 && set -a && source $ENTITY_DIR/.credentials
fi

# Package resolution — single source of truth. After all .env files have
# had a chance to set or override KOAD_IO_PACKAGE_DIRS, enforce a floor of
# ~/.forge/packages and sync Meteor's expected env var to match. Anything
# downstream (Meteor builds, harness shells, sub-processes) inherits the
# canonical cascade without needing the deprecated shim in .env.
#
# The framework tree ships no Meteor packages of its own: each koad:io-*
# package is an independent repository under ~/.forge/packages/.
export KOAD_IO_PACKAGE_DIRS="${KOAD_IO_PACKAGE_DIRS:-$HOME/.forge/packages}"
export METEOR_PACKAGE_DIRS="$KOAD_IO_PACKAGE_DIRS"

set +a

# Re-assert after the second cascade: .aliases (sourced between the two passes)
# is another file that could name a stranger's author, and the derivation is
# idempotent — an entity that names its own identity is left alone.
_koad_io_entity_git_identity

echo "-" >&2
# Framework commands — PATH-style search path, first entry = highest priority.
# Default: forge commands (kingdom business layer) searched before framework.
# Override via KOAD_IO_COMMANDS_DIRS in ~/.koad-io/.env to add more dirs.
# Kept KOAD_IO_COMMANDS_DIR pointing at the framework dir for any legacy consumer.
KOAD_IO_COMMANDS_DIRS="${KOAD_IO_COMMANDS_DIRS:-$HOME/.forge/commands:$HOME/.koad-io/commands}"
KOAD_IO_COMMANDS_DIR="$HOME/.koad-io/commands"
[[ $DEBUG ]] && echo "KOAD_IO_COMMANDS_DIRS=$KOAD_IO_COMMANDS_DIRS" >&2;

ENTITY_COMMANDS_DIR="$ENTITY_DIR/commands"
[[ $DEBUG ]] && echo "ENTITY_COMMANDS_DIR=$ENTITY_COMMANDS_DIR" >&2;

# Parse the commands path into an array and check any exist
IFS=':' read -ra _KOAD_IO_CMD_DIRS <<< "$KOAD_IO_COMMANDS_DIRS"
_ANY_FRAMEWORK_CMD_DIR=0
for _d in "${_KOAD_IO_CMD_DIRS[@]}"; do [[ -d $_d ]] && _ANY_FRAMEWORK_CMD_DIR=1 && break; done

# Check to see if we even have a command directory of that name or a file of the same name in the current working directory.  If not, then bail.
[[ $_ANY_FRAMEWORK_CMD_DIR -eq 0 ]] && [[ ! -d $ENTITY_COMMANDS_DIR ]] && [[ ! -d $PWD/commands/ ]]  && [[ ! -f $PWD/$1.sh ]] && echo "Cannot find that command, sorry..[command does not exist]" >&2 && exit 66;

# Command resolution: find the deepest matching command directory.
# Priority: CWD > entity > framework (higher priority can override, but only at equal or greater depth).
# This prevents a shallow entity folder from stomping a deeper framework command.
# note: we limit our abilities here by hard-wiring $1 thru $7 $8, this should not be hard-wired.
#
# Historical bug: depth-2+ lines used to carry `[[ ! -e $N ]]` CWD-existence
# guards. Those guards silently broke dispatch whenever a rooted entity ran
# `<entity> harness opencode` a second time — because the first run creates
# `$ENTITY_DIR/opencode/` as its XDG state dir, which then shadows the
# depth-2 sub-command path segment and collapses routing to `harness/`
# (producing "unknown harness 'opencode'"). The guard had no meaningful
# purpose at depth ≥ 2: intermediate positional args are sub-command names,
# not direct file arguments. Removed from depths 2-5 in all three sections
# (framework / entity / CWD). Depth-1 guard preserved — may still carry
# "treat $1 as a local script if it exists" semantics worth not touching.

COMMAND_DEPTH=0
# Resolution state must start clean. COMMAND_LOCATION / EXEC_FILE are exported at
# the bottom of this script so a command can find its own sibling files, which
# means any command.sh that shells out to `koad-io <something else>` hands its
# own values down. An inherited COMMAND_LOCATION is not merely noise: the shim
# probe eight lines below finds <stale dir>/command.sh and the process runs the
# WRONG command instead of resolving the one that was asked for.
# (`koad-io which` had been unsetting this pair by hand — see its unset block.)
unset EXEC_FILE COMMAND_LOCATION COMMAND_NAME EXEC_ARGS POTENTIAL_NAMED_COMMAND POTENTIAL_REMAINDER_ARGUMENTS

# find deepest globally available command, iterating KOAD_IO_COMMANDS_DIRS.
# List is PATH-style (first = highest priority); we iterate in reverse so that
# the "later scan wins at equal depth" rule naturally lets the first-listed
# dir win (it gets scanned last).
for ((_i=${#_KOAD_IO_CMD_DIRS[@]}-1; _i>=0; _i--)); do
    _D="${_KOAD_IO_CMD_DIRS[$_i]}"
    [[ -z $_D ]] || [[ ! -d $_D ]] && continue
    [[ $1 ]] && [[ ! -f $1.sh ]] && [[ -d $_D/$1/ ]]             && [[ 1 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=1 && COMMAND_LOCATION="$_D/$1"             && COMMAND_NAME=$1 && EXEC_ARGS=($2 $3 $4 $5 $6 $7 $8) && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
    [[ $2 ]] &&[[ -d $_D/$1/$2 ]]           && [[ 2 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=2 && COMMAND_LOCATION="$_D/$1/$2"          && COMMAND_NAME=$2 && EXEC_ARGS=($3 $4 $5 $6 $7 $8)    && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
    [[ $3 ]] &&[[ -d $_D/$1/$2/$3/ ]]       && [[ 3 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=3 && COMMAND_LOCATION="$_D/$1/$2/$3"       && COMMAND_NAME=$3 && EXEC_ARGS=($4 $5 $6 $7 $8)       && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
    [[ $4 ]] &&[[ -d $_D/$1/$2/$3/$4/ ]]    && [[ 4 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=4 && COMMAND_LOCATION="$_D/$1/$2/$3/$4"    && COMMAND_NAME=$4 && EXEC_ARGS=($5 $6 $7 $8)          && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
    [[ $5 ]] &&[[ -d $_D/$1/$2/$3/$4/$5/ ]] && [[ 5 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=5 && COMMAND_LOCATION="$_D/$1/$2/$3/$4/$5" && COMMAND_NAME=$5 && EXEC_ARGS=($6 $7 $8)             && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
done

# find deepest command from entity (only overrides framework at equal or greater depth)
[[ $1 ]] && [[ ! -f $1.sh ]] && [[ -d $ENTITY_COMMANDS_DIR/$1/ ]]               && [[ 1 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=1 && COMMAND_LOCATION="$ENTITY_COMMANDS_DIR/$1"              && COMMAND_NAME=$1 && EXEC_ARGS=("$2 $3 $4 $5 $6 $7 $8") && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
[[ $2 ]] &&[[ -d $ENTITY_COMMANDS_DIR/$1/$2/ ]]            && [[ 2 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=2 && COMMAND_LOCATION="$ENTITY_COMMANDS_DIR/$1/$2"           && COMMAND_NAME=$2 && EXEC_ARGS=("$3 $4 $5 $6 $7 $8")    && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
[[ $3 ]] &&[[ -d $ENTITY_COMMANDS_DIR/$1/$2/$3/ ]]         && [[ 3 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=3 && COMMAND_LOCATION="$ENTITY_COMMANDS_DIR/$1/$2/$3"        && COMMAND_NAME=$3 && EXEC_ARGS=("$4 $5 $6 $7 $8")       && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
[[ $4 ]] &&[[ -d $ENTITY_COMMANDS_DIR/$1/$2/$3/$4/ ]]      && [[ 4 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=4 && COMMAND_LOCATION="$ENTITY_COMMANDS_DIR/$1/$2/$3/$4"     && COMMAND_NAME=$4 && EXEC_ARGS=("$5 $6 $7 $8")          && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
[[ $5 ]] &&[[ -d $ENTITY_COMMANDS_DIR/$1/$2/$3/$4/$5/ ]]   && [[ 5 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=5 && COMMAND_LOCATION="$ENTITY_COMMANDS_DIR/$1/$2/$3/$4/$5"  && COMMAND_NAME=$5 && EXEC_ARGS=("$6 $7 $8")             && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;

# find deepest command from current working directory's command folder (only overrides at equal or greater depth)
[[ $1 ]] && [[ ! -f $1.sh ]] && [[ -d $CWD/commands/$1/ ]]             && [[ 1 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=1 && COMMAND_LOCATION="$CWD/commands/$1"             && COMMAND_NAME=$1 && EXEC_ARGS=("$2 $3 $4 $5 $6 $7 $8") && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
[[ $2 ]] &&[[ -d $CWD/commands/$1/$2/ ]]          && [[ 2 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=2 && COMMAND_LOCATION="$CWD/commands/$1/$2"          && COMMAND_NAME=$2 && EXEC_ARGS=("$3 $4 $5 $6 $7 $8")    && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
[[ $3 ]] &&[[ -d $CWD/commands/$1/$2/$3/ ]]       && [[ 3 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=3 && COMMAND_LOCATION="$CWD/commands/$1/$2/$3"       && COMMAND_NAME=$3 && EXEC_ARGS=("$4 $5 $6 $7 $8")       && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
[[ $4 ]] &&[[ -d $CWD/commands/$1/$2/$3/$4/ ]]    && [[ 4 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=4 && COMMAND_LOCATION="$CWD/commands/$1/$2/$3/$4"    && COMMAND_NAME=$4 && EXEC_ARGS=("$5 $6 $7 $8")          && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;
[[ $5 ]] &&[[ -d $CWD/commands/$1/$2/$3/$4/$5/ ]] && [[ 5 -ge $COMMAND_DEPTH ]] && COMMAND_DEPTH=5 && COMMAND_LOCATION="$CWD/commands/$1/$2/$3/$4/$5" && COMMAND_NAME=$5 && EXEC_ARGS=("$6 $7 $8")             && [[ $DEBUG ]] && echo "Found command directory: $COMMAND_LOCATION (depth $COMMAND_DEPTH)" >&2;

[[ $DEBUG ]] && echo

[[ $COMMAND_LOCATION ]] && [[ $DEBUG ]] && echo "POTENTIAL_COMMAND: $COMMAND_NAME" >&2
[[ $COMMAND_LOCATION ]] && [[ $DEBUG ]] && echo "POTENTIAL_EXEC_ARGS: ${EXEC_ARGS[@]}" >&2
[[ $COMMAND_LOCATION ]] && [[ $DEBUG ]] && echo >&2

[[ $COMMAND_LOCATION ]] && POTENTIAL_NAMED_COMMAND=${EXEC_ARGS[0]} && EXEC_ARGS=${EXEC_ARGS[@]} && [[ $DEBUG ]] && echo "POTENTIAL_NAMED_COMMAND: $POTENTIAL_NAMED_COMMAND" >&2 
[[ $COMMAND_LOCATION ]] && POTENTIAL_REMAINDER_ARGUMENTS=("${EXEC_ARGS[@]}") && unset POTENTIAL_REMAINDER_ARGUMENTS[0] && [[ $DEBUG ]] && echo "POTENTIAL_REMAINDER_ARGUMENTS: ${POTENTIAL_REMAINDER_ARGUMENTS[@]}" >&2 && echo >&2

# command file can either be named `command.sh` or have the same name as the command with .sh extension
[[ -f $COMMAND_LOCATION/command.sh ]]                  && echo "command.sh is found in $COMMAND_LOCATION" >&2                     && export EXEC_FILE="$COMMAND_LOCATION/command.sh";

[[ $DEBUG ]] && echo "checking for $COMMAND_LOCATION/$POTENTIAL_NAMED_COMMAND.sh" >&2
[[ -f $COMMAND_LOCATION/$POTENTIAL_NAMED_COMMAND.sh ]] && echo "$POTENTIAL_NAMED_COMMAND.sh is found in $COMMAND_LOCATION" >&2 && EXEC_ARGS="${POTENTIAL_REMAINDER_ARGUMENTS[@]}" && export EXEC_FILE="$COMMAND_LOCATION/$POTENTIAL_NAMED_COMMAND.sh";

# finally, find a command from current working directory of the same name
[[ -f $CWD/$1.sh ]] && echo "$1.sh is found in $CWD" >&2 &&  EXEC_ARGS="$2 $3 $4 $5 $6 $7 $8"&& export EXEC_FILE="$CWD/$1.sh" && COMMAND_LOCATION=$CWD;

# Harness safety net: a higher-priority command tree may intentionally carry
# docs/assets under `commands/harness/<name>/` without shipping a `command.sh`.
# When that happens, normal depth resolution picks the override path but leaves
# EXEC_FILE empty, even though the framework harness implementation exists.
# Fall back to the framework harness family for `harness`, `harness default`,
# and `harness <name>` so overrides can omit executable shims safely.
if [[ ! -n $EXEC_FILE ]] && [[ "$1" == "harness" ]]; then
    if [[ -n "$2" ]]; then
        _framework_harness_cmd="$HOME/.koad-io/commands/harness/$2/command.sh"
        if [[ -f "$_framework_harness_cmd" ]]; then
            COMMAND_LOCATION="$HOME/.koad-io/commands/harness/$2"
            EXEC_FILE="$_framework_harness_cmd"
            EXEC_ARGS="$3 $4 $5 $6 $7 $8"
            echo "framework harness/$2 fallback engaged: $EXEC_FILE" >&2
        fi
    else
        _framework_harness_cmd="$HOME/.koad-io/commands/harness/command.sh"
        if [[ -f "$_framework_harness_cmd" ]]; then
            COMMAND_LOCATION="$HOME/.koad-io/commands/harness"
            EXEC_FILE="$_framework_harness_cmd"
            EXEC_ARGS="$2 $3 $4 $5 $6 $7 $8"
            echo "framework harness fallback engaged: $EXEC_FILE" >&2
        fi
    fi
    unset _framework_harness_cmd
fi

# Resolution safety net — generalized 2026-10-18.
#
# A command directory with nothing executable in it is not a command. The scan
# above picks the deepest match and, at equal depth, the highest-priority one;
# if that directory ships no shim it used to terminate resolution outright and
# exit 66, even when a perfectly good lower-priority candidate existed.
#
# Live failure (wonderland, 2026-10-17): KOAD_IO_COMMANDS_DIRS lists
# ~/.dotfiles/commands after ~/.forge/commands, so at equal depth the later
# scan won and `koad-io inspect` resolved to ~/.dotfiles/commands/inspect —
# a directory whose only child is another directory — while
# ~/.forge/commands/inspect/command.sh sat there unused.
#
# So: keep walking the remaining candidates and take the first that actually
# ships a shim (`command.sh` or `<sub-command>.sh`). Walk order is the same rule
# the scan uses — deepest first, then priority order within a depth, because a
# deeper command still beats a shallower one.
#
# Priority order at equal depth (highest first) mirrors the scan below:
# CWD/commands > entity commands > KOAD_IO_COMMANDS_DIRS in listed order.
_koad_io_resolver_sources=()
[[ -d "$CWD/commands" ]]        && _koad_io_resolver_sources+=("$CWD/commands")
[[ -n "$ENTITY_COMMANDS_DIR" ]] && [[ -d "$ENTITY_COMMANDS_DIR" ]] && _koad_io_resolver_sources+=("$ENTITY_COMMANDS_DIR")
for _rs in "${_KOAD_IO_CMD_DIRS[@]}"; do
    [[ -n $_rs ]] && [[ -d $_rs ]] && _koad_io_resolver_sources+=("$_rs")
done

# Paths the resolver actually considered — named in the exit-66 message so the
# failure is diagnosable without DEBUG=1.
_RESOLVER_TRIED=()
[[ -n "${COMMAND_LOCATION:-}" ]] && _RESOLVER_TRIED+=("$COMMAND_LOCATION")

if [[ ! -n $EXEC_FILE ]]; then
    for ((_fd=5; _fd>=1; _fd--)); do
        for _src in "${_koad_io_resolver_sources[@]}"; do
            # Assemble <source>/<arg1>/<arg2>/… out to _fd depth segments.
            _cand="$_src"
            _have_all=1
            for ((_k=1; _k<=_fd; _k++)); do
                _tok="${!_k}"
                [[ -z "$_tok" ]] && _have_all=0 && break
                _cand="$_cand/$_tok"
            done
            (( _have_all )) || continue
            [[ -d "$_cand" ]] || continue
            [[ "$_cand" == "${COMMAND_LOCATION:-}" ]] && continue

            _named_i=$((_fd + 1))
            _named_tok="${!_named_i}"
            if [[ -f "$_cand/command.sh" ]] || { [[ -n "$_named_tok" ]] && [[ -f "$_cand/$_named_tok.sh" ]]; }; then
                COMMAND_DEPTH=$_fd
                COMMAND_LOCATION="$_cand"
                COMMAND_NAME="${!_fd}"
                POTENTIAL_NAMED_COMMAND="$_named_tok"
                POTENTIAL_REMAINDER_ARGUMENTS=("${@:$((_fd + 2))}")
                EXEC_ARGS=("${@:$((_fd + 1))}")
                # Same precedence as the shim check above: a named
                # <sub-command>.sh wins over command.sh when both exist.
                if [[ -n "$_named_tok" ]] && [[ -f "$_cand/$_named_tok.sh" ]]; then
                    EXEC_FILE="$_cand/$_named_tok.sh"
                else
                    EXEC_FILE="$_cand/command.sh"
                fi
                echo "resolver fallback: '${_RESOLVER_TRIED[0]:-no command directory}' has no shim — using $EXEC_FILE (depth $_fd)" >&2
                break 2
            fi
            _RESOLVER_TRIED+=("$_cand")
        done
    done
fi
unset _cand _tok _src _rs _fd _k _have_all _named_i _named_tok

# Make sure we have a valid command file to run, else crash 66.
# Name what was tried — a bare "could not find command file" hid a shimless
# directory shadowing a working one for a full day of debugging.
if [[ ! -n $EXEC_FILE ]]; then
    echo "Could not find command file for '${1:-<none>}' — checked:" >&2
    if [[ ${#_RESOLVER_TRIED[@]} -gt 0 ]]; then
        for _t in "${_RESOLVER_TRIED[@]}"; do echo "  $_t" >&2; done
    else
        echo "  no command directory matched under: ${_koad_io_resolver_sources[*]:-<none>}" >&2
    fi
    echo "EXEC_FILE: ${EXEC_FILE:-<unset>}" >&2

    # A first-class command must either work or explain itself. If the resolved
    # directory is a real command tree that simply ships no shim of its own,
    # name its sub-commands instead of dying silently — the umbrella shape
    # (`commands/<verb>/<sub>/command.sh` with nothing at `commands/<verb>/`) is
    # common enough that a bare invocation deserves directions, not exit 66.
    if [[ -n "${COMMAND_LOCATION:-}" ]] && [[ -d "$COMMAND_LOCATION" ]]; then
        _subs=()
        for _p in "$COMMAND_LOCATION"/*/; do
            [[ -d "$_p" ]] && [[ -f "$_p/command.sh" ]] && _subs+=("$(basename "$_p")")
        done
        if [[ ${#_subs[@]} -gt 0 ]]; then
            echo "  '$1' has sub-commands: ${_subs[*]}" >&2
            echo "  try: koad-io $1 ${_subs[0]} ..." >&2
        else
            echo "  '$COMMAND_LOCATION' exists but holds no command.sh and no sub-commands" >&2
        fi
        unset _subs _p
    fi
    exit 66
fi

# If the working directory contains environment and credentials, load them
[ -f $COMMAND_LOCATION/.env ]         && echo "loading $COMMAND_LOCATION/.env" >&2         && set -a && source $COMMAND_LOCATION/.env 
[ -f $COMMAND_LOCATION/.credentials ] && echo "loading $COMMAND_LOCATION/.credentials" >&2 && set -a && source $COMMAND_LOCATION/.credentials 


export COMMAND_LOCATION=$COMMAND_LOCATION
# if DEBUG is set, barf out some details.
[[ $DEBUG ]] && echo >&2
[[ $DEBUG ]] && echo "COMMAND_LOCATION=$COMMAND_LOCATION" >&2;
[[ $DEBUG ]] && echo "EXEC_FILE=$EXEC_FILE" >&2;
[[ $DEBUG ]] && echo "EXEC_ARGS=$EXEC_ARGS" >&2;
[[ $DEBUG ]] && echo >&2

# Check if the --dry-run flag is set. Read the pre-fence flag view, not a
# KOAD_IO_FLAGS string: `--dry-run` appearing AFTER `--` is data and must not
# switch the launcher into preview mode.
for _arg in ${_koad_io_flag_args[@]+"${_koad_io_flag_args[@]}"}; do
  [[ "$_arg" == "--dry-run" ]] && export DRY_RUN=true && break
done
unset _arg

# Compute the exec slice: the caller's argv, in the caller's order, minus only
# the command words resolution consumed. _CONSUMED counts leading POSITIONAL
# tokens -- exactly what the resolver consumed -- so the words to drop are
# _koad_io_positional_index[0 .. _CONSUMED-1].
#
# The old code sliced the POSITIONAL view ($@) and appended the flag view at the
# exec line. That pair IS the partition SPEC-245 removed: it relocated every flag
# behind the data, which is invisible in a token set and lethal to order.
if [[ -n "${EXEC_FILE:-}" ]]; then
  _CONSUMED=$COMMAND_DEPTH
  if [[ "$EXEC_FILE" == "$HOME/.koad-io/commands/harness/command.sh" ]]; then
    _CONSUMED=1
  elif [[ "$EXEC_FILE" == "$HOME/.koad-io/commands/harness/"*"command.sh" ]]; then
    _CONSUMED=2
  elif [[ "$EXEC_FILE" == "$COMMAND_LOCATION/$POTENTIAL_NAMED_COMMAND.sh" && -n "$POTENTIAL_NAMED_COMMAND" ]]; then
    _CONSUMED=$((COMMAND_DEPTH + 1))
  elif [[ "$EXEC_FILE" == "$CWD/$1.sh" ]]; then
    _CONSUMED=1
  fi
  koad_io_exec_slice "$_CONSUMED" "${_ORIG_ARGV[@]}"
else
  _koad_io_exec_args=()
  _koad_io_consumed_args=()
  _CONSUMED=0
fi

# What actually crosses the boundary. %q makes a token with spaces, a newline,
# or an empty string visible as ONE element instead of appearing to be two --
# the failure mode DEBUG exists to make findable (SPEC-245 m3).
if [[ $DEBUG ]]; then
  printf 'ORIGINAL_ARGV (%d):' "${#_ORIG_ARGV[@]}" >&2
  for _a in ${_ORIG_ARGV[@]+"${_ORIG_ARGV[@]}"}; do printf ' %q' "$_a" >&2; done
  echo >&2
  printf 'REMOVED_COMMAND_WORDS (%d):' "${#_koad_io_consumed_args[@]}" >&2
  for _a in ${_koad_io_consumed_args[@]+"${_koad_io_consumed_args[@]}"}; do printf ' %q' "$_a" >&2; done
  echo >&2
  printf 'EXEC_ARGV (%d):' "${#_koad_io_exec_args[@]}" >&2
  for _a in ${_koad_io_exec_args[@]+"${_koad_io_exec_args[@]}"}; do printf ' %q' "$_a" >&2; done
  echo >&2
  unset _a
fi

echo "--exec $EXEC_FILE ${_koad_io_exec_args[*]-}" >&2

# ---------------------------------------------------------------------------
# Executable-bit preflight (2026-10-31)
#
# The cascade resolves a command by DIRECTORY and then execs the shim inside it.
# If that shim is not executable, `exec` dies with the shell's own
# "Permission denied" and exit 126 — which names neither the file, nor the
# reason, nor the fix. That is the answer a learner got on a real sovereign
# install (valhala.is, 2026-10-21): the very first act of the entire install was
#     chmod +x ~/.koad-io/commands/curriculum/command.sh   # it was not executable
# because curriculum/command.sh had been committed 100644 while every other
# command.sh in the tree was 100755. The mode bit blocked the map (the then-27-note
# difficulty ramp `curriculum list` prints); three days later he hand-wrote the
# map and handed it in as homework.
#
# "Permission denied" is the wrong answer to "the repo shipped this file 644".
# Same reasoning as the module preflight below: detect the condition, name the
# cause, print the line that fixes it.
#
# The git index is the authority on what a clone will receive, so it decides
# between the two cases:
#   100755 in the index + not executable here → this checkout lost the bit
#     (rsync/copy/restore without modes). git itself says it should be
#     executable: restore it and carry on. Not silent — one line to stderr.
#   100644 in the index → the repository ships a non-executable command. No
#     local chmod can fix that for anyone else, so refuse and say so.
# ---------------------------------------------------------------------------
if [[ -n "${EXEC_FILE:-}" ]] && [[ -f "$EXEC_FILE" ]] && [[ ! -x "$EXEC_FILE" ]]; then
  _EXEC_DIR="$(cd "$(dirname "$EXEC_FILE")" 2>/dev/null && pwd)"
  _INDEX_MODE=""
  if [[ -n "$_EXEC_DIR" ]]; then
    _INDEX_MODE="$(cd "$_EXEC_DIR" && git ls-files -s -- "$(basename "$EXEC_FILE")" 2>/dev/null | awk 'NR==1{print $1}')"
  fi

  if [[ "$_INDEX_MODE" == "100755" ]]; then
    echo "[koad-io] $EXEC_FILE lost its executable bit locally (git index says 100755) — restored." >&2
    chmod +x "$EXEC_FILE" 2>/dev/null || true
  else
    {
      echo ""
      echo "[koad-io] This command is not executable, so the cascade cannot run it."
      echo "[koad-io]   file:      $EXEC_FILE"
      echo "[koad-io]   mode:      $(ls -ld "$EXEC_FILE" 2>/dev/null | awk '{print $1}')"
      case "$_INDEX_MODE" in
        100644)
          _REPO_TOP="$(cd "$_EXEC_DIR" && git rev-parse --show-toplevel 2>/dev/null)"
          _REPO_REL="${EXEC_FILE#"$_REPO_TOP"/}"
          echo "[koad-io]   committed: 100644  ← the repository ships this file non-executable"
          echo "[koad-io]"
          echo "[koad-io] A fresh clone inherits the index mode, so the defect is in the repo, not"
          echo "[koad-io] in your checkout. Chmod'ing it here fixes this machine and nobody else's."
          echo "[koad-io]"
          echo "[koad-io]   use it now:     chmod +x $EXEC_FILE"
          echo "[koad-io]   fix the repo:   git -C ${_REPO_TOP:-$_EXEC_DIR} update-index --chmod=+x ${_REPO_REL:-$(basename "$EXEC_FILE")} && git commit"
          unset _REPO_TOP _REPO_REL
          ;;
        '')
          echo "[koad-io]   committed: (not tracked by git)"
          echo "[koad-io]"
          echo "[koad-io]   fix it:         chmod +x $EXEC_FILE"
          ;;
        *)
          echo "[koad-io]   committed: $_INDEX_MODE"
          echo "[koad-io]"
          echo "[koad-io]   fix it:         chmod +x $EXEC_FILE"
          ;;
      esac
      echo "[koad-io]"
      echo "[koad-io] Every command.sh in a commands tree must be committed 755. Sweep for others:"
      echo "[koad-io]   koad-io test modes"
      echo ""
    } >&2
    unset _EXEC_DIR _INDEX_MODE
    exit 126
  fi
  unset _EXEC_DIR _INDEX_MODE
fi

# ---------------------------------------------------------------------------
# Module dependency preflight (2026-10-21)
#
# modules/node is the shared @koad-io/node module. Its package.json and lockfile
# are committed; node_modules is not (60+ packages). Nothing ever installed it.
#
# On a machine where `npm ci` was never run — a fresh clone, or a box that has
# been running koad:io for months (citadel, 2026-10-21) — every command that
# imports the module dies with a raw Node stack trace:
#
#   Error [ERR_MODULE_NOT_FOUND]: Cannot find package '@scure/bip39'
#     imported from /home/koad/.koad-io/modules/node/index.js
#
# A stack trace is the wrong answer to "one directory is missing". Detect the
# condition before the import can fail and name the fix. Detection is by
# reference, not by a hardcoded command list: if the resolved script mentions
# modules/node, it needs the module.
# ---------------------------------------------------------------------------
_MODULE_DIR="$HOME/.koad-io/modules/node"
if [[ -n "${EXEC_FILE:-}" ]] && [[ -d "$_MODULE_DIR" ]] && [[ ! -d "$_MODULE_DIR/node_modules" ]]; then
  case "$EXEC_FILE" in
    "$HOME/.koad-io/commands/install/"*)
      : ;;  # the remedy must be able to run
    *)
      _needs_mod=0
      if /usr/bin/grep -qs 'modules/node\|@koad-io/node' "$EXEC_FILE" 2>/dev/null; then
        _needs_mod=1
      elif /usr/bin/grep -rqs --include='*.mjs' --include='*.js' \
             'modules/node\|@koad-io/node' "$(dirname "$EXEC_FILE")" 2>/dev/null; then
        # sibling helper scripts (ceremony.mjs and friends) may be what imports it
        _needs_mod=1
      fi
      if [[ "$_needs_mod" -eq 1 ]]; then
        {
          echo ""
          echo "[koad-io] This command needs the @koad-io/node dependencies, and they are not installed."
          echo "[koad-io]   missing: $_MODULE_DIR/node_modules"
          echo "[koad-io]   fix:     koad-io install deps"
          echo "[koad-io]"
          echo "[koad-io] Running it now would fail with ERR_MODULE_NOT_FOUND on '@scure/bip39'."
          echo "[koad-io] Run as your normal user — never with sudo."
          echo ""
        } >&2
        exit 1
      fi
      ;;
  esac
fi

# All is well, lets go!
# _koad_io_exec_args is the caller's argv minus the command words the launcher
# resolved -- same tokens, same relative order, same multiplicity, no insertions
# and no moves (SPEC-245 A-3). Nothing is appended after it: appending the flag
# view here is what resurrected the partition (m4).
exec "$EXEC_FILE" ${_koad_io_exec_args[@]+"${_koad_io_exec_args[@]}"}
