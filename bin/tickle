#!/usr/bin/env bash
#
# tickle — surface and dispatch entity tickles with express context
#
# A system-level command. Lives on PATH at ~/.koad-io/bin/tickle.
#
# Usage:
#   tickle               list all entities' due tickles (no dispatch)
#   tickle <entity>      dispatch entity to handle its due tickles
#   tickle --dry-run <entity>
#                        print the express prompt, dispatch nothing (test seam)
#   tickle --help        this message
#
# "tickle juno" asks `tickler ls` what is due for Juno, builds an express prompt
# containing ONLY those tickles and minimal identity, and dispatches to Juno's
# default harness. The entity doesn't get full session context — just enough to
# act on the tickles and stamp completion.
#
# ── what this file no longer does (2026-11-17) ──────────────────────────────
#
# It used to scan the tree itself: is_open() in awk, get_subject(), scan_entity(),
# discover_entities(), a copy of the terminal-status regex, and its own date
# arithmetic for the days/weeks/months axes. Three other scripts did the same and
# the four disagreed — 130 due here, 150 items there, 169 open on the board. Two
# of the copies carried the comment "if you change one, change both". That
# comment was the bug report.
#
# All of it is now one command call:
#
#   tickler ls --due --paths --entity=<name> --host=$HOST   one absolute path per line
#   tickler ls --due --tsv --all-entities                   entity, path, title, rel
#
# Why the CALL and not a sourced file: ~/.koad-io is substrate and has to stay
# clonable on its own, so it may not source anything out of ~/.forge. A command
# is a contract; a path into another repo is a dependency. If the command is not
# installed, this script says so and exits non-zero rather than printing a
# confident "no tickles due" — an unavailable reader and an empty board are
# different answers, and this family of tools has paid for that lesson before.

set -euo pipefail

HOST="$(hostname -s)"
KOAD_IO="${KOAD_IO_BIN:-$HOME/.koad-io/bin/koad-io}"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  sed -n '3,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
fi

# ── the reader ──────────────────────────────────────────────────────────────
# `tickler ls` is the API. Called through the router so the command cascade
# decides where it lives; no path into ~/.forge is baked in here.
_tickler_ls() {
  "$KOAD_IO" tickler ls "$@" 2>/dev/null
}

# An unavailable reader must not read as an empty board. Probe once, cheaply:
# ask a question the reader can always answer.
if ! _tickler_ls --due --paths --all-entities >/dev/null 2>&1; then
  echo "tickle: cannot read the tickler — \`koad-io tickler ls\` is not available." >&2
  echo "  An unavailable reader is NOT the same as no tickles due." >&2
  exit 2
fi

# ── Mode: list (no entity arg) ──────────────────────────────────────────────
if [[ $# -eq 0 ]]; then
  echo
  echo "tickle — due tickles across all entities"
  echo "host: $HOST | date: $(date +%F)"
  echo

  # entity<TAB>abs_path<TAB>title<TAB>rel — one call, every entity.
  # Sorted by entity before grouping: awk emits groups in first-appearance order,
# so this is what keeps the listing alphabetical instead of by whatever the
# reader happened to walk first.
  rows=$(_tickler_ls --due --tsv --all-entities | sort -t$'\t' -k1,1)

  if [[ -z "$rows" ]]; then
    echo "no tickles due for any entity right now"
    echo
    exit 0
  fi

  printf '%s\n' "$rows" | awk -F'\t' '
    { count[$1]++; if (!($1 in seen)) { seen[$1] = 1; order[++n] = $1 } line[$1] = line[$1] "  - " $3 " (" $4 ")\n" }
    END {
      for (i = 1; i <= n; i++) {
        e = order[i]
        printf "%s: %d due\n%s\n", e, count[e], line[e]
      }
    }'

  total=$(printf '%s\n' "$rows" | wc -l | tr -d ' ')
  echo "total: ${total} due"
  echo "dispatch with: tickle <entity>"
  echo
  exit 0
fi

# ── Mode: dispatch (entity arg given) ──────────────────────────────────────
DRY_RUN=false
if [[ "${1:-}" == "--dry-run" ]]; then
  DRY_RUN=true
  shift
fi

TARGET="${1:-}"
if [[ -z "$TARGET" ]]; then
  echo "tickle: entity required (or no argument at all to list every entity)" >&2
  exit 64
fi

TARGET_LOWER="$(printf '%s' "$TARGET" | tr '[:upper:]' '[:lower:]')"
TARGET_DIR="$HOME/.$TARGET_LOWER"

if [[ ! -d "$TARGET_DIR" ]]; then
  echo "Error: entity dir not found at $TARGET_DIR" >&2
  exit 64
fi

# One call, one answer. The reader decides what is due — not this script.
paths=()
while IFS= read -r _p; do
  [[ -n "$_p" ]] && paths+=("$_p")
done < <(_tickler_ls --due --paths --entity="$TARGET_LOWER" --host="$HOST")

count=${#paths[@]}

echo
echo "tickle · scanning $TARGET"
echo "host: $HOST | date: $(date +%F)"
echo

if [[ "$count" -eq 0 ]]; then
  echo "no tickles due for $TARGET right now"
  exit 0
fi

echo "$count due tickle(s) found"
for f in "${paths[@]}"; do
  echo "  - $(basename "$f")"
done
echo

# Minimal identity: first line of ENTITY.md or memories/001-identity.md
identity_line=""
if [[ -f "$TARGET_DIR/ENTITY.md" ]]; then
  identity_line=$(grep -m1 '^>' "$TARGET_DIR/ENTITY.md" 2>/dev/null || head -3 "$TARGET_DIR/ENTITY.md" | tail -1)
fi
if [[ -z "$identity_line" ]] && [[ -f "$TARGET_DIR/memories/001-identity.md" ]]; then
  identity_line=$(head -5 "$TARGET_DIR/memories/001-identity.md" | tail -1)
fi

# Assemble tickle content
tickle_content=""
idx=0
for f in "${paths[@]}"; do
  idx=$((idx + 1))
  tickle_content+="
--- Tickle $idx of $count: $(basename "$f") ---

$(cat "$f")

--- end tickle $idx ---
"
done

EXPRESS_PROMPT="Express context — tickle processing mode.

You are ${TARGET}. ${identity_line}
Entity dir: ${TARGET_DIR}
Host: ${HOST}
Working directory: ${PWD}

You have ${count} due tickle(s). This is a focused session — handle
these tickles, commit when done, report what you did. Do NOT load full
context, scan issues, or start general work. Process tickles only.

${tickle_content}

For each tickle:
1. Read it and understand what is being asked
2. Follow references if you need additional context
3. Do the work described
4. Stamp completion: set the completion field to the current ISO 8601 timestamp
5. Commit your changes to the entity repo

When done, print a brief summary of what you handled."

if [[ "$DRY_RUN" == true ]]; then
  printf '%s\n' "$EXPRESS_PROMPT"
  echo
  echo "(dry run — nothing dispatched)"
  exit 0
fi

echo "dispatching $TARGET to handle $count tickle(s)..."
echo

export PROMPT="$EXPRESS_PROMPT"
exec "$TARGET_LOWER" harness default
