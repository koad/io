#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SELF_DIR/../helpers/kingdom-safe-search.sh"

SYSTEM_FIND="/usr/bin/find"

show_help() {
  cat <<'EOF'
kingdom-safe find

Usage:
  find [--raw|--full] [--show-excludes] [find args...]
  find --kingdom-help

Behavior:
  - preserves standard find path + expression shape
  - injects a default prune layer built from the shared kingdom-safe policy:
    generated/cached dirs, agent scratch trees, session and transcript
    archives, and live runtime substrate — pruned by path BEFORE traversal
  - naming an excluded tree as a root searches it anyway, with a notice
  - use --raw or --full to bypass the prune layer entirely

Notes:
  - wrapper help: find --kingdom-help
  - GNU find help: /usr/bin/find --help
EOF
}

exec_raw() {
  exec "$SYSTEM_FIND" "$@"
}

if [[ $# -eq 0 ]]; then
  kg_safe_print_banner "find"
  exec "$SYSTEM_FIND" .
fi

passthrough=()
raw_mode=0
show_excludes=0
for arg in "$@"; do
  case "$arg" in
    --raw|--full)
      raw_mode=1
      ;;
    --show-excludes)
      show_excludes=1
      ;;
    --kingdom-help)
      show_help
      exit 0
      ;;
    *)
      passthrough+=("$arg")
      ;;
  esac
done

if [[ $show_excludes -eq 1 && ${#passthrough[@]} -eq 0 ]]; then
  kg_safe_show_excludes "find"
  exit 0
fi

if [[ $raw_mode -eq 1 ]]; then
  exec_raw "${passthrough[@]}"
fi

if [[ ${#passthrough[@]} -eq 1 && "${passthrough[0]}" == "--version" ]]; then
  exec_raw "${passthrough[@]}"
fi

leading_opts=()
roots=()
expr=()
index=0
parsing_leading=1
parsing_roots=1

while [[ $index -lt ${#passthrough[@]} ]]; do
  arg="${passthrough[$index]}"

  if [[ $parsing_leading -eq 1 ]]; then
    case "$arg" in
      -H|-L|-P|-D|-O)
        leading_opts+=("$arg")
        if [[ "$arg" == "-D" || "$arg" == "-O" ]]; then
          index=$((index + 1))
          if [[ $index -lt ${#passthrough[@]} ]]; then
            leading_opts+=("${passthrough[$index]}")
          fi
        fi
        index=$((index + 1))
        continue
        ;;
      --)
        parsing_leading=0
        parsing_roots=0
        index=$((index + 1))
        continue
        ;;
      *)
        parsing_leading=0
        ;;
    esac
  fi

  if [[ $parsing_roots -eq 1 ]]; then
    case "$arg" in
      ''|'-'|'!'|'('|')'|','|';'|+|-*)
        parsing_roots=0
        ;;
      *)
        roots+=("$arg")
        index=$((index + 1))
        continue
        ;;
    esac
  fi

  expr+=("$arg")
  index=$((index + 1))
done

if [[ ${#roots[@]} -eq 0 ]]; then
  roots=(.)
fi

if [[ ${#expr[@]} -eq 0 ]]; then
  expr=(-print)
fi

expr_has_action=0
for arg in "${expr[@]}"; do
  case "$arg" in
    -print|-print0|-ls|-fls|-delete|-quit|-exec|-execdir|-ok|-okdir|-fprint|-fprint0|-fprintf)
      expr_has_action=1
      break
      ;;
  esac
done
if [[ $expr_has_action -eq 0 ]]; then
  expr+=( -print )
fi

cmd=("$SYSTEM_FIND")
# The prune expression is built per root, because a relative root (`.`) makes
# absolute `-path` exclusions inert unless they are re-expressed relative to it.
# The policy itself lives in helpers/kingdom-safe-search.sh.

kg_safe_print_banner "find"
if [[ $show_excludes -eq 1 ]]; then
  kg_safe_show_excludes "find" >&2
fi

overall=0
for root in "${roots[@]}"; do
  kg_safe_prune_args "$root"
  cmd=("$SYSTEM_FIND")
  for arg in "${leading_opts[@]}"; do
    cmd+=("$arg")
  done
  cmd+=("$root")
  if [[ $KG_ROOT_EXCLUDED -eq 1 ]]; then
    # Named an excluded tree as the root: search it, but say so.
    kg_safe_note_explicit_root "find" "$root" "$KG_ROOT_ZONE"
  else
    cmd+=("${KG_PRUNE_ARGS[@]}" -o)
  fi
  for arg in "${expr[@]}"; do
    cmd+=("$arg")
  done

  rc=0
  set +e
  "${cmd[@]}"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    overall=$rc
  fi
done

exit "$overall"
