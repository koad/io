#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SELF_DIR/../helpers/kingdom-safe-search.sh"

SYSTEM_GREP="/usr/bin/grep"
SYSTEM_FIND="/usr/bin/find"

# ── Dialect ───────────────────────────────────────────────────────────────────
# The wrapper advertises "regex", so it speaks ERE (POSIX extended) by default.
# BRE is still reachable, but only explicitly — see --kingdom-help.
#
# This default is a deliberate, documented semantic change: under BRE the
# escapes \| \( \) \{ \} \+ \? change meaning. Call sites in the kingdom were
# audited for that (see the migration note in the help text); the call sites
# that relied on BRE alternation now say `-E` in their own arguments.
KG_GREP_DIALECT="${KOAD_IO_GREP_DIALECT:-ere}"

show_help() {
  cat <<'EOF'
kingdom-safe grep

Usage:
  grep [--raw|--full] [--show-excludes] [--kingdom-dialect=<d>] [grep args...]
  grep --kingdom-help

Dialect (read this before writing a pattern):
  default: ERE — POSIX extended regex.  `a|b`, `(x|y)`, `+`, `?`, `{n,m}`
  mean what you expect from something labelled "Regex pattern".

  Override one call:   --kingdom-dialect=ere|bre|fixed|perl
  Override a session:  KOAD_IO_GREP_DIALECT=bre
  Override in args:    pass -E / -F / -G / -P yourself — the wrapper then
                       adds no dialect flag of its own.

  Migration note (2026-10-18): the default flipped from BRE to ERE.
  Under ERE these BRE escapes change meaning and must be rewritten:
      \|  ->  |          \( \)  ->  ( )
      \+  ->  +          \?  ->  ?
      \{ \} -> { }       (literal braces: \{ becomes \{ … use -F or escape the
                         brace as [{] to keep it literal)
  Literal-pipe intent: use --kingdom-dialect=fixed, or escape it as [|].

Invalid patterns are errors, never misses:
  a pattern the dialect cannot compile exits 2 and prints the pattern and the
  reason. It never prints "no matches". `grep 'foo('` is an error, not a
  clean answer of absence.

Behavior:
  - passes plain stdin/file grep through to /usr/bin/grep
  - when recursive grep flags are present (-r, -R, --recursive,
    --directories=recurse, --dereference-recursive), walks files through a
    kingdom-safe layer that prunes whole classes of tree by path BEFORE
    traversal: generated/cached directories, agent scratch trees, session and
    transcript archives, and live runtime substrate
  - use --raw or --full to bypass the safe excludes entirely (the dialect
    still applies — --raw is about which files are walked, not how patterns
    are read)

Why exclusion and not a timeout:
  a process in uninterruptible disk wait (STAT D) ignores signals until its I/O
  completes, so a timeout cannot rescue a walk that has already opened the
  wrong tree. Not opening it is the fix. On 2026-10-18 a recursive grep walked
  ~/.sibyl/work/ and the calling harness wrote nothing for 9m05s. The policy
  lives in helpers/kingdom-safe-search.sh and is printed by --show-excludes.

Nothing is made unreachable:
  name an excluded tree as the search root and it IS searched, with a notice on
  stderr. --raw bypasses the whole policy.

Walk budget:
  a recursive walk that would touch more than KOAD_IO_SAFE_MAX_FILES files
  (default 5000000) is refused before a single file is read — with the count,
  the reason, and the ways out. Never a silent, truncated answer.

Notes:
  - wrapper help: grep --kingdom-help
  - GNU grep help: /usr/bin/grep --help
EOF
}

dialect_flag() {
  case "$1" in
    ere)   printf '%s' "-E" ;;
    bre)   printf '%s' "-G" ;;
    fixed) printf '%s' "-F" ;;
    perl)  printf '%s' "-P" ;;
  esac
}

dialect_label() {
  case "$1" in
    ere)   printf '%s' "ERE (POSIX extended)" ;;
    bre)   printf '%s' "BRE (POSIX basic)" ;;
    fixed) printf '%s' "fixed strings (literal)" ;;
    perl)  printf '%s' "PCRE (perl)" ;;
  esac
}

# Compile every pattern against /dev/null before a single file is walked.
# grep exit 2 on a batch target is swallowed by `find -exec ... {} +` (find
# reports 1 for any failing -exec), so in the recursive path — the default
# for the harness tool — an invalid pattern would otherwise degrade straight
# into "No matches". Validate first, and fail loudly.
#
# There are TWO ways an engine declines to read a pattern as written, and only
# one of them is exit 2:
#   rc 2                     — it does not compile at all, e.g. `foo(`
#   rc 0/1 with stderr       — it compiles by REINTERPRETING the syntax, e.g.
#                              `a(?=b)` -> "warning: ? at start of expression"
#                              (ERE has no lookahead; '?' becomes a literal)
# Both are patterns the caller did not write. Answering "no matches" for
# either is the same class of lie, so both are hard failures.
validate_patterns() {
  local flag="$1"
  shift
  [[ $# -gt 0 ]] || return 0
  [[ -z "$flag" ]] && return 0
  local pat reason rc
  for pat in "$@"; do
    set +e
    reason="$("$SYSTEM_GREP" "$flag" -e "$pat" /dev/null 2>&1 >/dev/null)"
    rc=$?
    set -e
    if [[ $rc -eq 2 || -n "$reason" ]]; then
      # strip the "grep: " / "/usr/bin/grep: " prefix grep itself printed
      reason="${reason#*grep: }"
      if [[ $rc -eq 2 ]]; then
        printf 'grep: invalid pattern: %s\n' "$pat" >&2
      else
        printf 'grep: inexpressible pattern: %s\n' "$pat" >&2
      fi
      printf 'grep: dialect: %s\n' "$DIALECT_LABEL" >&2
      printf 'grep: reason: %s\n' "$reason" >&2
      printf 'grep: this is an error, not a clean miss — nothing was searched.\n' >&2
      printf 'grep: dialect defaults to ERE; `grep --kingdom-help` explains --kingdom-dialect\n' >&2
      exit 2
    fi
  done
}

kg_print_dialect_banner() {
  [[ -t 2 ]] || return 0
  [[ "${KOAD_IO_QUIET:-}" == "1" ]] && return 0
  printf '[grep:safe] dialect: %s\n' "$1" >&2
}

KG_GREP_INJECT=""

exec_raw() {
  if [[ -n "$KG_GREP_INJECT" ]]; then
    exec "$SYSTEM_GREP" "$KG_GREP_INJECT" "$@"
  fi
  exec "$SYSTEM_GREP" "$@"
}

passthrough=()
raw_mode=0
show_excludes=0
dialect_override=""
expect_dialect=0
for arg in "$@"; do
  if [[ $expect_dialect -eq 1 ]]; then
    dialect_override="$arg"
    expect_dialect=0
    continue
  fi
  case "$arg" in
    --raw|--full)
      raw_mode=1
      ;;
    --show-excludes)
      show_excludes=1
      ;;
    --kingdom-dialect=*)
      dialect_override="${arg#--kingdom-dialect=}"
      ;;
    --kingdom-dialect)
      expect_dialect=1
      ;;
    --kingdom-help)
      show_help
      exit 0
      ;;
    *)
      passthrough+=("$arg")
      ;;
  esac
done

if [[ $expect_dialect -eq 1 ]]; then
  printf 'grep: --kingdom-dialect needs a value (ere|bre|fixed|perl)\n' >&2
  exit 2
fi

if [[ -n "$dialect_override" ]]; then
  KG_GREP_DIALECT="$dialect_override"
fi

case "$KG_GREP_DIALECT" in
  ere|bre|fixed|perl) ;;
  *)
    printf 'grep: unknown dialect "%s" — expected ere, bre, fixed, or perl\n' "$KG_GREP_DIALECT" >&2
    exit 2
    ;;
esac

DIALECT_LABEL="$(dialect_label "$KG_GREP_DIALECT")"

if [[ $show_excludes -eq 1 && ${#passthrough[@]} -eq 0 ]]; then
  kg_safe_show_excludes "grep"
  exit 0
fi

if [[ ${#passthrough[@]} -eq 0 ]]; then
  KG_GREP_INJECT="$(dialect_flag "$KG_GREP_DIALECT")"
  exec_raw
fi

if [[ ${#passthrough[@]} -eq 1 && "${passthrough[0]}" == "--version" ]]; then
  exec_raw "${passthrough[@]}"
fi

recursive=0
follow_symlinks=0
user_binary_mode=0
pattern_set=0
expect_value=0
expect_kind=""
expect_patkind=""
after_ddash=0
user_dialect=0
patterns=()
paths=()

for arg in "${passthrough[@]}"; do
  if [[ $after_ddash -eq 1 ]]; then
    if [[ $pattern_set -eq 0 ]]; then
      pattern_set=1
      patterns+=("$arg")
    else
      paths+=("$arg")
    fi
    continue
  fi

  if [[ $expect_value -eq 1 ]]; then
    case "$expect_kind" in
      pattern)
        pattern_set=1
        [[ "$expect_patkind" == "e" ]] && patterns+=("$arg")
        ;;
      recursive-dir)
        [[ "$arg" == "recurse" ]] && recursive=1
        ;;
      binary)
        user_binary_mode=1
        ;;
    esac
    expect_value=0
    expect_kind=""
    expect_patkind=""
    continue
  fi

  case "$arg" in
    --)
      after_ddash=1
      continue
      ;;
    --recursive)
      recursive=1
      continue
      ;;
    --dereference-recursive)
      recursive=1
      follow_symlinks=1
      continue
      ;;
    --directories=recurse)
      recursive=1
      continue
      ;;
    --directories)
      expect_value=1
      expect_kind="recursive-dir"
      continue
      ;;
    --extended-regexp|--basic-regexp|--fixed-strings|--perl-regexp)
      user_dialect=1
      continue
      ;;
    --regexp=*)
      pattern_set=1
      patterns+=("${arg#--regexp=}")
      continue
      ;;
    --file=*)
      pattern_set=1
      continue
      ;;
    --regexp)
      expect_value=1
      expect_kind="pattern"
      expect_patkind="e"
      continue
      ;;
    --file)
      expect_value=1
      expect_kind="pattern"
      expect_patkind="f"
      continue
      ;;
    --include=*|--exclude=*|--exclude-dir=*|--label=*)
      continue
      ;;
    --include|--exclude|--exclude-dir|--label)
      expect_value=1
      expect_kind="other"
      continue
      ;;
    --binary-files=*)
      user_binary_mode=1
      continue
      ;;
    --binary-files)
      expect_value=1
      expect_kind="binary"
      continue
      ;;
    --text|-a|-I)
      user_binary_mode=1
      ;;
    --version)
      continue
      ;;
  esac

  if [[ "$arg" == --* ]]; then
    continue
  fi

  if [[ "$arg" == -* && "$arg" != "-" ]]; then
    short="${arg#-}"
    short_len=${#short}
    i=0
    while [[ $i -lt $short_len ]]; do
      ch="${short:$i:1}"
      case "$ch" in
        r)
          recursive=1
          ;;
        R)
          recursive=1
          follow_symlinks=1
          ;;
        a|I)
          user_binary_mode=1
          ;;
        E|F|G|P)
          user_dialect=1
          ;;
        e|f)
          pattern_set=1
          if [[ $((i + 1)) -lt $short_len ]]; then
            # attached value: -epattern
            [[ "$ch" == "e" ]] && patterns+=("${short:$((i + 1))}")
            i=$short_len
            continue
          fi
          expect_value=1
          expect_kind="pattern"
          expect_patkind="$ch"
          i=$short_len
          continue
          ;;
        A|B|C|D|d|f|m)
          if [[ $((i + 1)) -eq $short_len ]]; then
            expect_value=1
            expect_kind="other"
          fi
          i=$short_len
          continue
          ;;
      esac
      i=$((i + 1))
    done
    continue
  fi

  if [[ $pattern_set -eq 0 ]]; then
    pattern_set=1
    patterns+=("$arg")
  else
    paths+=("$arg")
  fi
done

# A caller that declared its own dialect (in args) keeps control; we add
# nothing and validate nothing on its behalf.
if [[ $user_dialect -eq 0 ]]; then
  KG_GREP_INJECT="$(dialect_flag "$KG_GREP_DIALECT")"
  validate_patterns "$KG_GREP_INJECT" "${patterns[@]}"
else
  DIALECT_LABEL="caller-specified (-E/-F/-G/-P in args)"
fi

if [[ $raw_mode -eq 1 ]]; then
  exec_raw "${passthrough[@]}"
fi

if [[ $recursive -eq 0 ]]; then
  exec_raw "${passthrough[@]}"
fi

parsed_path_count=${#paths[@]}
if [[ ${#paths[@]} -eq 0 ]]; then
  paths=(".")
fi

if [[ $parsed_path_count -gt 0 ]]; then
  arg_limit=$(( ${#passthrough[@]} - parsed_path_count ))
  final_grep_args=("${passthrough[@]:0:$arg_limit}")
else
  final_grep_args=("${passthrough[@]}")
fi

if [[ -n "$KG_GREP_INJECT" ]]; then
  final_grep_args=("$KG_GREP_INJECT" "${final_grep_args[@]}")
fi

if [[ $user_binary_mode -eq 0 ]]; then
  final_grep_args+=("-I")
fi

kg_safe_print_banner "grep"
kg_print_dialect_banner "$DIALECT_LABEL"
if [[ $show_excludes -eq 1 ]]; then
  kg_safe_show_excludes "grep" >&2
fi

overall_rc=1
update_rc() {
  local rc="$1"
  if [[ $rc -eq 2 ]]; then
    overall_rc=2
  elif [[ $rc -eq 0 && $overall_rc -ne 2 ]]; then
    overall_rc=0
  fi
}

run_file_batch() {
  local rc
  set +e
  "$SYSTEM_GREP" "${final_grep_args[@]}" "$@"
  rc=$?
  set -e
  update_rc "$rc"
}

# ── The walk ────────────────────────────────────────────────────────────
# One traversal collects the file list; the budget is checked against that
# list; only then does grep open anything. The ordering is deliberate — the
# budget decision has to be made before any output exists, or refusing would
# itself be a truncation.

SAFE_MAX_FILES="${KOAD_IO_SAFE_MAX_FILES:-5000000}"
case "$SAFE_MAX_FILES" in
  ''|*[!0-9]*)
    printf 'grep: KOAD_IO_SAFE_MAX_FILES must be a non-negative integer, got "%s"\n' "$SAFE_MAX_FILES" >&2
    exit 2
    ;;
esac
export KOAD_IO_SAFE_MAX_FILES="$SAFE_MAX_FILES"

KG_LIST_FILE=""
kg_grep_cleanup() {
  [[ -n "$KG_LIST_FILE" && -f "$KG_LIST_FILE" ]] && rm -f "$KG_LIST_FILE"
  return 0
}
trap kg_grep_cleanup EXIT

KG_TRAVERSAL_FATAL=0

enumerate_root() {
  local root="$1"
  local out="$2"
  local -a cmd=("$SYSTEM_FIND")

  if [[ $follow_symlinks -eq 1 ]]; then
    cmd+=("-L")
  fi

  kg_safe_prune_args "$root"
  cmd+=("$root")

  if [[ $KG_ROOT_EXCLUDED -eq 1 ]]; then
    # The caller named an excluded tree as the root. Search it — a silent empty
    # answer here would be the same class of lie as a false "No matches" — but
    # say so, because every broad walk will skip it.
    kg_safe_note_explicit_root "grep" "$root" "$KG_ROOT_ZONE"
    cmd+=(-type f -print0)
  else
    cmd+=("${KG_PRUNE_ARGS[@]}" -o -type f -print0)
  fi

  local rc
  set +e
  "${cmd[@]}" >> "$out"
  rc=$?
  set -e
  # GNU find: 1 = minor problems (a path could not be stat'ed), 2 = serious.
  if [[ $rc -ge 2 ]]; then
    printf 'grep: traversal of %s failed (find exit %d) — the walk is incomplete\n' "$root" "$rc" >&2
    KG_TRAVERSAL_FATAL=1
  elif [[ $rc -ne 0 ]]; then
    printf 'grep: note: traversal of %s reported skipped paths (find exit %d)\n' "$root" "$rc" >&2
  fi
  return 0
}

grep_enumerated() {
  local list="$1"
  local -a batch=()
  local path
  while IFS= read -r -d '' path; do
    batch+=("$path")
    if [[ ${#batch[@]} -ge 2000 ]]; then
      run_file_batch "${batch[@]}"
      batch=()
    fi
  done < "$list"
  if [[ ${#batch[@]} -gt 0 ]]; then
    run_file_batch "${batch[@]}"
  fi
  return 0
}

file_targets=()
dir_targets=()
for path in "${paths[@]}"; do
  if [[ "$path" == "-" ]]; then
    file_targets+=("$path")
  elif [[ -d "$path" ]]; then
    dir_targets+=("$path")
  else
    file_targets+=("$path")
  fi
done

if [[ ${#file_targets[@]} -gt 0 ]]; then
  run_file_batch "${file_targets[@]}"
fi

if [[ ${#dir_targets[@]} -gt 0 ]]; then
  KG_LIST_FILE="$(mktemp "${TMPDIR:-/tmp}/kg-grep-files.XXXXXXXX")"
  for path in "${dir_targets[@]}"; do
    enumerate_root "$path" "$KG_LIST_FILE"
  done

  file_total="$(tr -cd '\0' < "$KG_LIST_FILE" | wc -c)"
  file_total="${file_total//[!0-9]/}"
  [[ -n "$file_total" ]] || file_total=0

  if [[ $KG_TRAVERSAL_FATAL -eq 1 ]]; then
    printf 'grep: refusing to answer from an incomplete walk — nothing was searched\n' >&2
    exit 2
  fi

  if [[ $file_total -gt $SAFE_MAX_FILES ]]; then
    printf 'grep: refusing to walk %s files (budget %s, KOAD_IO_SAFE_MAX_FILES)\n' \
      "$file_total" "$SAFE_MAX_FILES" >&2
    printf 'grep: roots: %s\n' "$(kg_safe_join_by ' ' "${dir_targets[@]}")" >&2
    printf 'grep: reason: a walk this wide is a D-state risk, not a search — a process\n' >&2
    printf 'grep:         in uninterruptible disk wait cannot be interrupted by a timeout.\n' >&2
    printf 'grep: this is an error, not a short answer — nothing was searched.\n' >&2
    printf 'grep: narrow the root, raise KOAD_IO_SAFE_MAX_FILES, or pass --raw.\n' >&2
    exit 2
  fi

  if [[ $file_total -eq 0 ]]; then
    printf 'grep: note: 0 files remained after the safe excludes — nothing was searched\n' >&2
    printf 'grep: note: --show-excludes lists what was pruned; --raw bypasses it\n' >&2
  fi

  grep_enumerated "$KG_LIST_FILE"
fi

exit "$overall_rc"
